---
import { SITE } from "../data/site";
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  crumbs?: { name: string; path: string }[];
}
const { title, description, image = "/og.jpg", type = "website", noindex = false, schema = [], crumbs } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/"), SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const org = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  "@id": `${SITE.url}/#org`,
  name: SITE.name,
  slogan: `${SITE.tagline} ${SITE.mission}`,
  description: SITE.description,
  url: SITE.url,
  logo: new URL("/logo.png", SITE.url).href,
  sameAs: [SITE.instagram],
  founder: { "@type": "Person", name: SITE.founder.name, sameAs: SITE.founder.url },
  areaServed: { "@type": "City", name: SITE.city },
  address: { "@type": "PostalAddress", addressLocality: SITE.city, addressRegion: SITE.region, addressCountry: SITE.country },
  knowsAbout: ["Sports events", "Running events", "Brand activations", "Athlete partnerships", "Wellness programmes"],
  ...(SITE.email ? { email: SITE.email } : {}),
  ...(SITE.phone ? { telephone: SITE.phone } : {}),
};
const website = { "@context": "https://schema.org", "@type": "WebSite", "@id": `${SITE.url}/#site`, name: SITE.name, url: SITE.url, inLanguage: "en-IN", publisher: { "@id": `${SITE.url}/#org` } };
const breadcrumb = crumbs && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.path, SITE.url).href })),
};
const graph = [org, website, ...(breadcrumb ? [breadcrumb] : []), ...schema];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="geo.region" content="IN-MH" />
<meta name="geo.placename" content={SITE.city} />
<meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
